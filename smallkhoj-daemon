#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DAEMON_DIR="$ROOT_DIR/agent/daemon/aaa-daemon"
SERVER_URL="http://localhost:8000"
CONNECT_TOKEN=""
MACHINE_TOKEN=""
PROXY_PORT="0"
LOCK_FILE="${SMALLKHOJ_DAEMON_LOCK:-${HOME}/.smallkhoj/daemon.pid}"
DAEMON_PID=""

kill_pid_tree() {
  local pid="$1" sig="${2:-TERM}"
  [[ -n "$pid" ]] || return 0
  kill -0 "$pid" 2>/dev/null || return 0
  local child
  for child in $(pgrep -P "$pid" 2>/dev/null || true); do
    kill_pid_tree "$child" "$sig"
  done
  kill -"$sig" "$pid" 2>/dev/null || true
}

stop_pid_tree() {
  local pid="$1"
  [[ -n "$pid" ]] || return 0
  kill -0 "$pid" 2>/dev/null || return 0
  kill_pid_tree "$pid" TERM
  local i
  for i in 1 2 3 4 5; do
    kill -0 "$pid" 2>/dev/null || return 0
    sleep 1
  done
  kill_pid_tree "$pid" KILL
}

cleanup_old() {
  [[ -f "$LOCK_FILE" ]] || return 0
  local old_pid
  old_pid="$(cat "$LOCK_FILE" 2>/dev/null || true)"
  rm -f "$LOCK_FILE"
  if [[ -n "$old_pid" ]] && kill -0 "$old_pid" 2>/dev/null; then
    echo "Stopping existing daemon (PID $old_pid) and its runtime children..." >&2
    stop_pid_tree "$old_pid"
  fi
}

cleanup_on_exit() {
  if [[ -n "${DAEMON_PID:-}" ]]; then
    stop_pid_tree "$DAEMON_PID"
  fi
  rm -f "$LOCK_FILE" 2>/dev/null || true
}

trap 'cleanup_on_exit' EXIT
trap 'cleanup_on_exit; exit 130' INT
trap 'cleanup_on_exit; exit 143' TERM
trap 'cleanup_on_exit; exit 129' HUP

usage() {
  cat <<'USAGE'
smallkhoj-daemon 0.1.0

Usage:
  smallkhoj-daemon connect --token sk_connect_... [--server http://localhost:8000]
  smallkhoj-daemon start --machine-token sk_machine_... [--server http://localhost:8000]
  smallkhoj-daemon --version

This wrapper starts the local aaa-daemon without requiring users to navigate
into agent/daemon/aaa-daemon.
USAGE
}

if [[ "${1:-}" == "--version" || "${1:-}" == "version" ]]; then
  echo "smallkhoj-daemon 0.1.0"
  exit 0
fi

MODE="${1:-}"
if [[ -z "$MODE" || "$MODE" == "--help" || "$MODE" == "-h" ]]; then
  usage
  exit 0
fi
shift || true

while [[ $# -gt 0 ]]; do
  case "$1" in
    --token)
      CONNECT_TOKEN="${2:-}"
      shift 2
      ;;
    --machine-token)
      MACHINE_TOKEN="${2:-}"
      shift 2
      ;;
    --server)
      SERVER_URL="${2:-}"
      shift 2
      ;;
    --proxy-port)
      PROXY_PORT="${2:-}"
      shift 2
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if [[ ! -f "$DAEMON_DIR/dist/cmd/main.js" ]]; then
  echo "Daemon build missing — running npm install && npm run build ..." >&2
  cd "$DAEMON_DIR"
  npm install --silent 2>&1
  npm run build 2>&1
  if [[ ! -f "dist/cmd/main.js" ]]; then
    echo "Build failed: dist/cmd/main.js still missing" >&2
    exit 1
  fi
  echo "Build succeeded." >&2
  cd "$ROOT_DIR"
fi

# Always rebuild to ensure dist matches current source (fast if already up-to-date)
cd "$DAEMON_DIR"
npm run build 2>&1 || {
  echo "Warning: incremental build failed, proceeding with existing dist" >&2
}
cd "$ROOT_DIR"

cd "$DAEMON_DIR"

# Derive WebSocket URL from server URL (http -> ws, https -> wss, with correct path)
WS_URL="${SERVER_URL/#http:/ws:}"
WS_URL="${WS_URL/#https:/wss:}"
# Ensure the WS path includes the agent API route prefix
WS_URL="${WS_URL%/}/internal/agent-api/ws"

# Singleton enforcement: stop any previous daemon wrapper (and its runtime
# children) before starting a new one, then record our own PID.
cleanup_old
mkdir -p "$(dirname "$LOCK_FILE")"
echo "$$" > "$LOCK_FILE"

run_daemon() {
  # Run daemon in background so we can trap signals and clean up its process tree.
  "$@" &
  DAEMON_PID=$!
  wait "$DAEMON_PID" || true
}

case "$MODE" in
  connect)
    if [[ -z "$CONNECT_TOKEN" ]]; then
      echo "Missing --token sk_connect_..." >&2
      exit 2
    fi
    run_daemon env SLOCK_CONNECT_TOKEN="$CONNECT_TOKEN" SLOCK_ALLOW_WRITES=1 \
      node dist/cmd/main.js start --foreground \
        --runtime none \
        --server "$SERVER_URL" \
        --ws "$WS_URL" \
        --proxy-port "$PROXY_PORT" \
        --register-daemon
    ;;
  start)
    if [[ -z "$MACHINE_TOKEN" ]]; then
      echo "Missing --machine-token sk_machine_..." >&2
      exit 2
    fi
    run_daemon env SLOCK_AGENT_TOKEN="$MACHINE_TOKEN" SLOCK_ALLOW_WRITES=1 \
      node dist/cmd/main.js start --foreground \
        --runtime none \
        --server "$SERVER_URL" \
        --ws "$WS_URL" \
        --agent-id aaaa0000-0000-0000-0000-000000000001 \
        --register-daemon
    ;;
  *)
    echo "Unknown mode: $MODE" >&2
    usage >&2
    exit 2
    ;;
esac
