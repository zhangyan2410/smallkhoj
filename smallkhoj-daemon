#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DAEMON_DIR="$ROOT_DIR/agent/daemon/aaa-daemon"
SERVER_URL="http://localhost:8000"
CONNECT_TOKEN=""
MACHINE_TOKEN=""
PROXY_PORT="0"

usage() {
  cat <<'USAGE'
smallkhoj-daemon 0.1.0

Usage:
  smallkhoj-daemon connect --token sk_connect_... [--server http://localhost:8000]
  smallkhoj-daemon start --machine-token sk_machine_... [--server http://localhost:8000]
  smallkhoj-daemon --version

This wrapper starts the local aaa-daemon without requiring users to navigate
into agent/daemon/aaa-daemon.
USAGE
}

if [[ "${1:-}" == "--version" || "${1:-}" == "version" ]]; then
  echo "smallkhoj-daemon 0.1.0"
  exit 0
fi

MODE="${1:-}"
if [[ -z "$MODE" || "$MODE" == "--help" || "$MODE" == "-h" ]]; then
  usage
  exit 0
fi
shift || true

while [[ $# -gt 0 ]]; do
  case "$1" in
    --token)
      CONNECT_TOKEN="${2:-}"
      shift 2
      ;;
    --machine-token)
      MACHINE_TOKEN="${2:-}"
      shift 2
      ;;
    --server)
      SERVER_URL="${2:-}"
      shift 2
      ;;
    --proxy-port)
      PROXY_PORT="${2:-}"
      shift 2
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if [[ ! -f "$DAEMON_DIR/dist/cmd/main.js" ]]; then
  echo "Daemon build missing — running npm install && npm run build ..." >&2
  cd "$DAEMON_DIR"
  npm install --silent 2>&1
  npm run build 2>&1
  if [[ ! -f "dist/cmd/main.js" ]]; then
    echo "Build failed: dist/cmd/main.js still missing" >&2
    exit 1
  fi
  echo "Build succeeded." >&2
  cd "$ROOT_DIR"
fi

# Always rebuild to ensure dist matches current source (fast if already up-to-date)
cd "$DAEMON_DIR"
npm run build 2>&1 || {
  echo "Warning: incremental build failed, proceeding with existing dist" >&2
}
cd "$ROOT_DIR"

cd "$DAEMON_DIR"

# Derive WebSocket URL from server URL (http -> ws, https -> wss, with correct path)
WS_URL="${SERVER_URL/#http:/ws:}"
WS_URL="${WS_URL/#https:/wss:}"
# Ensure the WS path includes the agent API route prefix
WS_URL="${WS_URL%/}/internal/agent-api/ws"

case "$MODE" in
  connect)
    if [[ -z "$CONNECT_TOKEN" ]]; then
      echo "Missing --token sk_connect_..." >&2
      exit 2
    fi
    SLOCK_CONNECT_TOKEN="$CONNECT_TOKEN" SLOCK_ALLOW_WRITES=1 \
      node dist/cmd/main.js start --foreground \
        --runtime none \
        --server "$SERVER_URL" \
        --ws "$WS_URL" \
        --proxy-port "$PROXY_PORT"
    ;;
  start)
    if [[ -z "$MACHINE_TOKEN" ]]; then
      echo "Missing --machine-token sk_machine_..." >&2
      exit 2
    fi
    SLOCK_AGENT_TOKEN="$MACHINE_TOKEN" SLOCK_ALLOW_WRITES=1 \
      node dist/cmd/main.js start --foreground \
        --runtime none \
        --server "$SERVER_URL" \
        --ws "$WS_URL" \
        --agent-id aaaa0000-0000-0000-0000-000000000001
    ;;
  *)
    echo "Unknown mode: $MODE" >&2
    usage >&2
    exit 2
    ;;
esac
