{
  "name": "@smallkhoj/smallkhoj-daemon",
  "version": "0.2.7",
  "description": "Minimal Slock Agent Daemon — architecture based on opencan-daemon",
  "main": "dist/cmd/main.js",
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "smallkhoj-daemon": "dist/cmd/main.js",
    "aura": "dist/cmd/main.js",
    "aaa-daemon": "dist/cmd/main.js",
    "slock": "dist/slock-cli.js",
    "aaa-chat-bridge": "dist/chat-bridge.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:claude-e2e": "npm run build && node test/claude-spawn-e2e.mjs",
    "test:slock-real-e2e": "npm run build && node test/slock-real-e2e.mjs",
    "dev": "tsc --watch",
    "start": "node dist/cmd/main.js start --foreground",
    "daemon": "node dist/cmd/main.js start",
    "attach": "node dist/cmd/main.js attach",
    "smoke:codex-acp": "npm run build && node dist/scripts/codex-acp-smoke.js",
    "smoke:goose-acp": "npm run build && node dist/scripts/goose-acp-smoke.js",
    "status": "node dist/cmd/main.js status",
    "stop": "node dist/cmd/main.js stop"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "@mariozechner/pi-coding-agent": "0.73.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^12.0.0",
    "ws": "^8.16.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.3.0"
  }
}
