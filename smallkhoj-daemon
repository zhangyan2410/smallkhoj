#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DAEMON_DIR="$ROOT_DIR/agent/daemon/aaa-daemon"
SERVER_URL="http://localhost:8000"
CONNECT_TOKEN=""
MACHINE_TOKEN=""
PROXY_PORT="0"
LOCK_DIR="${SMALLKHOJ_DAEMON_LOCK_DIR:-${HOME}/.smallkhoj/daemons}"
LOCK_FILE="${SMALLKHOJ_DAEMON_LOCK:-}"

normalize_server_url_for_lock() {
  local raw="${1%/}"
  raw="$(printf '%s' "$raw" | awk '{
    scheme = $0
    sub("://.*", "", scheme)
    rest = $0
    sub("^[^:]+://", "", rest)
    host_port = rest
    sub("/.*", "", host_port)
    suffix = rest
    sub("^[^/]*", "", suffix)
    host = host_port
    port = ""
    if (host_port ~ /^\\[[^]]+\\]/) {
      host = host_port
      sub("^\\[", "", host)
      sub("\\].*", "", host)
      port = host_port
      sub("^\\[[^]]+\\]", "", port)
    } else if (host_port ~ /:/) {
      host = host_port
      sub(":.*", "", host)
      port = host_port
      sub("^[^:]+", "", port)
    }
    scheme = tolower(scheme)
    host = tolower(host)
    if (host == "localhost") {
      host = "127.0.0.1"
    }
    print scheme "://" host port suffix
  }')"
  printf '%s' "$raw"
}

guard_existing_daemon() {
  [[ -f "$LOCK_FILE" ]] || return 0
  local old_pid
  old_pid="$(cat "$LOCK_FILE" 2>/dev/null || true)"
  if [[ -n "$old_pid" ]] && kill -0 "$old_pid" 2>/dev/null; then
    echo "Existing daemon for $SERVER_URL is already running (PID $old_pid) from $LOCK_FILE. Stop it before starting another daemon for the same server." >&2
    exit 3
  fi
  rm -f "$LOCK_FILE"
}

usage() {
  cat <<'USAGE'
smallkhoj-daemon 0.1.0

Usage:
  smallkhoj-daemon connect --token sk_connect_... [--server http://localhost:8000]
  smallkhoj-daemon start --machine-token sk_machine_... [--server http://localhost:8000]
  smallkhoj-daemon --version

This wrapper starts the local aaa-daemon without requiring users to navigate
into agent/daemon/aaa-daemon.
USAGE
}

if [[ "${1:-}" == "--version" || "${1:-}" == "version" ]]; then
  echo "smallkhoj-daemon 0.1.0"
  exit 0
fi

MODE="${1:-}"
if [[ -z "$MODE" || "$MODE" == "--help" || "$MODE" == "-h" ]]; then
  usage
  exit 0
fi
shift || true

while [[ $# -gt 0 ]]; do
  case "$1" in
    --token)
      CONNECT_TOKEN="${2:-}"
      shift 2
      ;;
    --machine-token)
      MACHINE_TOKEN="${2:-}"
      shift 2
      ;;
    --server)
      SERVER_URL="${2:-}"
      shift 2
      ;;
    --proxy-port)
      PROXY_PORT="${2:-}"
      shift 2
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if [[ -z "$LOCK_FILE" ]]; then
  LOCK_SERVER_URL="$(normalize_server_url_for_lock "$SERVER_URL")"
  LOCK_KEY="$(printf '%s' "$LOCK_SERVER_URL" | shasum -a 256 | awk '{print substr($1, 1, 16)}')"
  LOCK_FILE="${LOCK_DIR}/daemon-${LOCK_KEY}.pid"
fi

if [[ ! -f "$DAEMON_DIR/dist/cmd/main.js" ]]; then
  echo "Daemon build missing — running npm install && npm run build ..." >&2
  cd "$DAEMON_DIR"
  npm install --silent 2>&1
  npm run build 2>&1
  if [[ ! -f "dist/cmd/main.js" ]]; then
    echo "Build failed: dist/cmd/main.js still missing" >&2
    exit 1
  fi
  echo "Build succeeded." >&2
  cd "$ROOT_DIR"
fi

# Always rebuild to ensure dist matches current source (fast if already up-to-date)
cd "$DAEMON_DIR"
npm run build 2>&1 || {
  echo "Warning: incremental build failed, proceeding with existing dist" >&2
}
cd "$ROOT_DIR"

cd "$DAEMON_DIR"

# Derive WebSocket URL from server URL (http -> ws, https -> wss, with correct path)
WS_URL="${SERVER_URL/#http:/ws:}"
WS_URL="${WS_URL/#https:/wss:}"
# Ensure the WS path includes the agent API route prefix
WS_URL="${WS_URL%/}/internal/agent-api/ws"

# Singleton detection is scoped to the selected backend server. A stale or
# invalid connect command must never terminate a healthy daemon.
guard_existing_daemon
mkdir -p "$(dirname "$LOCK_FILE")"
echo "$$" > "$LOCK_FILE"

case "$MODE" in
  connect)
    if [[ -z "$CONNECT_TOKEN" ]]; then
      echo "Missing --token sk_connect_..." >&2
      exit 2
    fi
    exec env SLOCK_CONNECT_TOKEN="$CONNECT_TOKEN" SLOCK_ALLOW_WRITES=1 \
      node dist/cmd/main.js start --foreground \
        --runtime none \
        --server "$SERVER_URL" \
        --ws "$WS_URL" \
        --proxy-port "$PROXY_PORT" \
        --register-daemon
    ;;
  start)
    if [[ -z "$MACHINE_TOKEN" ]]; then
      echo "Missing --machine-token sk_machine_..." >&2
      exit 2
    fi
    exec env SLOCK_AGENT_TOKEN="$MACHINE_TOKEN" SLOCK_ALLOW_WRITES=1 \
      node dist/cmd/main.js start --foreground \
        --runtime none \
        --server "$SERVER_URL" \
        --ws "$WS_URL" \
        --agent-id aaaa0000-0000-0000-0000-000000000001 \
        --register-daemon
    ;;
  *)
    echo "Unknown mode: $MODE" >&2
    usage >&2
    exit 2
    ;;
esac
