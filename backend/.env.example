# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true
BACKEND_CORS_ORIGINS=
AUTH_BRIDGE_SECRET=sk_auth_bridge_local_dev_secret_min_32_chars

# Database
DATABASE_URL=postgresql+asyncpg://smallkhoj:smallkhoj@localhost:5432/smallkhoj

# LLM (支持 OpenAI 兼容 API)
LLM_API_KEY=sk-your-key-here
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Jira write-back (no real secrets in repo)
JIRA_EMAIL=
JIRA_API_TOKEN=

# Feishu reply write-back (no real secrets in repo)
FEISHU_REPLY_BASE_URL=https://open.feishu.cn
FEISHU_REPLY_ACCESS_TOKEN=

# Feishu long-connection worker runtime (no real secrets in repo)
FEISHU_WORKER_ENABLED=false
FEISHU_WORKER_CONNECTOR_ID=
FEISHU_WORKER_JIRA_CONNECTOR_ID=
FEISHU_WORKER_CREATOR_ID=
FEISHU_WORKER_BOT_OPEN_ID=
FEISHU_WORKER_BOT_NAME=SmallKhoj
FEISHU_WORKER_APP_ID=
FEISHU_WORKER_APP_SECRET=
